APP_ENV=local
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgres://user:pass@localhost:5432/centrobrasilnoclima

JWT_SECRET=change_me
JWT_ISSUER=centrobrasilnoclima
JWT_AUDIENCE=centrobrasilnoclima-api
JWT_TTL_SECONDS=900

PASSWORD_PEPPER=change_me

EMAIL_FROM="App Name" <no-reply@example.com>
EMAIL_CONFIRM_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

LOG_LEVEL=info
LOG_FORMAT=text
