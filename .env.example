APP_ENV=local
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080
BUILD_VERSION=development
BUILD_TIMESTAMP_MS=0

DATABASE_URL=postgres://user:pass@localhost:5432/climabalance

VALKEY_URL=redis://localhost:6379

JWT_SECRET=change_me
JWT_ISSUER=climabalance
JWT_AUDIENCE=climabalance-api
JWT_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# HttpOnly cookie used to rotate refresh tokens without exposing them to frontend JavaScript.
REFRESH_COOKIE_NAME=cb_refresh_token
# Optional cookie domain. Leave empty in local dev; set in staging/prod when frontend and API share a parent domain.
# REFRESH_COOKIE_DOMAIN=.example.com
# Cookie path restricted to auth endpoints that need refresh/revoke semantics.
REFRESH_COOKIE_PATH=/api/v1/auth
# SameSite policy for the refresh cookie. Use "none" only if frontend/API are truly cross-site.
REFRESH_COOKIE_SAME_SITE=lax
# Sends the refresh cookie only over HTTPS when true. Keep false for plain-http local development.
REFRESH_COOKIE_SECURE=false
# Shared secret used to validate simulated payment webhooks.
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# Stripe integration.
# In local development, Stripe is enabled whenever STRIPE_SECRET_KEY is set.
# Keep these variables filled when testing real Stripe Checkout locally.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PLATFORM_FEE_PERCENT=5
# Local filesystem paths for uploaded area media and generated certificates.
AREA_MEDIA_STORAGE_PATH=./storage/area-media
CERTIFICATE_STORAGE_PATH=./storage/certificates

# Default max purchasable trees per area when no per-area limit is set.
DEFAULT_MAX_PURCHASABLE_TREES=100

PASSWORD_PEPPER=change_me

EMAIL_FROM="App Name <no-reply@example.com>"
EMAIL_CONFIRM_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

LOG_LEVEL=info
LOG_FORMAT=text
TRUSTED_PROXY_IPS=
