-- =========================
-- Migration 005: Create Areas and Projects Tables
-- Created: 2026-02-01
-- Description: Creates tables for areas/projects with point-based locations
-- =========================

-- =========================
-- 1. Create areas table
-- =========================
CREATE TABLE areas (
  id VARCHAR(36) PRIMARY KEY,
  owner_user_id VARCHAR(36) NOT NULL,
  name VARCHAR(200) NOT NULL,
  description TEXT,
  latitude DECIMAL(10, 8) NOT NULL,
  longitude DECIMAL(11, 8) NOT NULL,
  biome VARCHAR(100),
  state VARCHAR(50),
  city VARCHAR(100),
  status VARCHAR(30) NOT NULL DEFAULT 'draft',
  audit_status VARCHAR(30),
  audit_notes TEXT,
  audited_by_user_id VARCHAR(36),
  audited_at TIMESTAMP,
  total_capacity_t_co2e DECIMAL(18, 6),
  committed_t_co2e DECIMAL(18, 6) DEFAULT 0,
  t_co2e_per_tree_per_year DECIMAL(10, 6),
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  deleted_at TIMESTAMP,
  FOREIGN KEY (owner_user_id) REFERENCES users(id),
  FOREIGN KEY (audited_by_user_id) REFERENCES users(id),
  CONSTRAINT check_status CHECK (status IN ('draft', 'pending_audit', 'approved', 'active', 'rejected', 'suspended')),
  CONSTRAINT check_audit_status CHECK (audit_status IS NULL OR audit_status IN ('pending', 'approved', 'rejected')),
  CONSTRAINT check_capacity CHECK (total_capacity_t_co2e IS NULL OR total_capacity_t_co2e >= 0),
  CONSTRAINT check_committed CHECK (committed_t_co2e >= 0),
  CONSTRAINT check_latitude CHECK (latitude >= -90 AND latitude <= 90),
  CONSTRAINT check_longitude CHECK (longitude >= -180 AND longitude <= 180)
);

CREATE INDEX idx_areas_owner ON areas(owner_user_id);
CREATE INDEX idx_areas_status ON areas(status);
CREATE INDEX idx_areas_biome ON areas(biome);
CREATE INDEX idx_areas_location ON areas(latitude, longitude);
CREATE INDEX idx_areas_deleted ON areas(deleted_at);

-- =========================
-- 2. Create area_criteria table (audit checklist)
-- =========================
CREATE TABLE area_criteria (
  id VARCHAR(36) PRIMARY KEY,
  area_id VARCHAR(36) NOT NULL,
  criterion_key VARCHAR(100) NOT NULL,
  criterion_label VARCHAR(200) NOT NULL,
  met BOOLEAN NOT NULL DEFAULT FALSE,
  notes TEXT,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  deleted_at TIMESTAMP,
  FOREIGN KEY (area_id) REFERENCES areas(id)
);

CREATE INDEX idx_area_criteria_area_id ON area_criteria(area_id);
CREATE INDEX idx_area_criteria_deleted ON area_criteria(deleted_at);

-- =========================
-- 3. Update compensation_projection to ensure FK exists
-- =========================
-- Verify/update the FK constraint
ALTER TABLE compensation_projection
  DROP CONSTRAINT IF EXISTS compensation_projection_area_id_fkey;

ALTER TABLE compensation_projection
  ADD CONSTRAINT compensation_projection_area_id_fkey
  FOREIGN KEY (area_id) REFERENCES areas(id);

-- =========================
-- 4. Create view for available areas (active with capacity)
-- =========================
CREATE OR REPLACE VIEW available_areas AS
SELECT
  a.*,
  (a.total_capacity_t_co2e - a.committed_t_co2e) AS available_t_co2e
FROM areas a
WHERE a.status = 'active'
  AND a.deleted_at IS NULL
  AND (a.total_capacity_t_co2e - a.committed_t_co2e) > 0;

-- =========================
-- Comments for documentation
-- =========================
COMMENT ON TABLE areas IS 'Stores reforestation areas/projects with point-based locations';
COMMENT ON COLUMN areas.latitude IS 'Latitude in decimal degrees (WGS84), range: -90 to 90';
COMMENT ON COLUMN areas.longitude IS 'Longitude in decimal degrees (WGS84), range: -180 to 180';
COMMENT ON COLUMN areas.status IS 'Area workflow status: draft → pending_audit → approved → active (or rejected/suspended)';
COMMENT ON COLUMN areas.total_capacity_t_co2e IS 'Maximum carbon sequestration capacity in tonnes CO2 equivalent';
COMMENT ON COLUMN areas.committed_t_co2e IS 'Amount of capacity already allocated to compensations';

COMMENT ON TABLE area_criteria IS 'Socio-environmental audit criteria checklist for each area';
COMMENT ON COLUMN area_criteria.criterion_key IS 'Unique key for criterion type (e.g., legal_documentation, native_species)';
COMMENT ON COLUMN area_criteria.met IS 'Whether the criterion was met during audit';
