{
  "name": "climabalance-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts --host 0.0.0.0",
    "start": "bun src/main.ts",
    "build": "bun x tsc -p tsconfig.json",
    "lint": "eslint .",
    "audit": "bun audit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "bun x tsc --noEmit",
    "db:create": "bun src/scripts/create-db.ts",
    "seed:admin": "bun src/scripts/seed-admin.ts",
    "seed:roles": "bun src/scripts/seed-roles.ts",
    "seed:map": "bun src/scripts/seed-map-areas.ts",
    "migrate": "bun src/scripts/migrate.ts",
    "test": "bun test tests src/**/*.test.ts"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.4",
    "pg": "^8.23.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "overrides": {
    "brace-expansion": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.19.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0",
    "prettier": "^3.9.6"
  }
}
