{
  "name": "climabalance-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts --host 0.0.0.0",
    "start": "bun src/main.ts",
    "build": "bun x tsc -p tsconfig.json",
    "lint": "eslint .",
    "audit": "bun audit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "bun x tsc --noEmit",
    "db:create": "bun src/scripts/create-db.ts",
    "seed:admin": "bun src/scripts/seed-admin.ts",
    "seed:e2e": "bun src/scripts/seed-e2e.ts",
    "seed:roles": "bun src/scripts/seed-roles.ts",
    "seed:map": "bun src/scripts/seed-map-areas.ts",
    "migrate": "bun src/scripts/migrate.ts",
    "test": "bun test tests src/**/*.test.ts"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "ioredis": "^5.11.0",
    "nodemailer": "^8.0.9",
    "pg": "^8.21.0",
    "proj4": "^2.20.8",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/proj4": "^2.19.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0",
    "prettier": "^3.8.3"
  }
}
